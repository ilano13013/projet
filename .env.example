# PRIMA — Variables d'environnement (MODÈLE)
#
# ⚠ Ce fichier est un MODÈLE sans secret. Il décrit la configuration du
# SERVEUR prévu au Lot 1. Tant que le serveur n'existe pas, ces variables ne
# sont PAS utilisées par l'application statique actuelle.
#
# Ne jamais committer de secrets réels. Copier en `.env` (git-ignoré) côté
# serveur et renseigner des valeurs de TEST uniquement.

# --- Général ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Région d'hébergement effective (UE recommandée pour des données sensibles)
HOSTING_REGION=

# --- Base de données relationnelle transactionnelle ---
DATABASE_URL=

# --- Sessions / sécurité ---
SESSION_SECRET=
# Cookies: HttpOnly/Secure/SameSite gérés côté serveur
CSRF_SECRET=

# --- Fournisseur d'identité (OIDC géré recommandé) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# MFA au moins pour les administrateurs
MFA_REQUIRED_ROLES=admin

# --- Stockage de fichiers privé (liens temporaires) ---
FILE_STORAGE_BUCKET=
FILE_STORAGE_KEY=
FILE_STORAGE_SECRET=
FILE_SIGNED_URL_TTL_SECONDS=300
# Stockage disque privé (dev/staging) : répertoire hors webroot + secret de signature des liens
FILE_STORAGE_DIR=
FILE_SIGNING_SECRET=

# --- Email transactionnel (file de tâches serveur, idempotente) ---
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Paiement SaaS (MODE TEST uniquement) ---
# Abonnement du cabinet au service. NE PAS mélanger avec les honoraires d'avocat.
PAYMENT_PROVIDER=
PAYMENT_TEST_PUBLIC_KEY=
PAYMENT_TEST_SECRET_KEY=
PAYMENT_WEBHOOK_SIGNING_SECRET=
# Identifiants de PRIX Stripe (test) par formule — HT/TTC et conditions à décider par l'éditeur
PRICE_PREMIUM=
PRICE_EXPERT=

# --- Téléconsultation (fournisseur EXTERNE, pas de visio native) ---
# Hôtes autorisés, séparés par des virgules (défaut : meet.jit.si, whereby.com, zoom.us, teams.microsoft.com, meet.google.com)
VISIO_ALLOWED_HOSTS=
